apiVersion: lab/v1
kind: Repository

metadata:
  name: {{ name }}
  description: Generated by `lab init`. Describe the repository here.
  owners:
    - {{ owner }}

spec:
  project: {{ project_id }}

  runtime:
    type: python
    version: "3.12"

  container:
    dockerfile: containers/Dockerfile
    context: .

  commands:
    test:
      - pytest
      - -q
    smoke:
      - python
      - -m
      - {{ package }}.run
      - --config
      - configs/smoke.yaml
    run:
      - python
      - -m
      - {{ package }}.run
      - --config
      - "${LAB_EXPERIMENT_CONFIG}"

  outputs:
    directory: results

  reporting:
    template: default
