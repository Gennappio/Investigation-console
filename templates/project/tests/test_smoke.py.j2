"""Smoke test generated by `lab init`. Run from the project root:

    PYTHONPATH=src pytest
"""

import json
import sys

from {{ package }}.run import main


def test_smoke(tmp_path, monkeypatch):
    monkeypatch.setattr(
        sys,
        "argv",
        ["run", "--config", "configs/smoke.yaml", "--output-dir", str(tmp_path)],
    )
    main()
    summary = json.loads((tmp_path / "summary.json").read_text())
    assert summary["status"] == "ok"
    assert summary["config"]["repetitions"] == 2
