#!/bin/bash
#SBATCH --job-name={{ job_name | sh }}
#SBATCH --chdir={{ request.working_directory | string | sh }}
#SBATCH --output={{ stdout_path | string | sh }}
#SBATCH --error={{ stderr_path | string | sh }}
#SBATCH --cpus-per-task={{ resources.cpus }}
#SBATCH --mem={{ resources.memory_mb }}M
{% if resources.time_limit %}#SBATCH --time={{ resources.time_limit | sh }}
{% endif %}{% if resources.gpus %}#SBATCH --gres=gpu:{{ resources.gpus }}
{% endif %}{% if options.partition %}#SBATCH --partition={{ options.partition | sh }}
{% endif %}{% if options.account %}#SBATCH --account={{ options.account | sh }}
{% endif %}{% if options.qos %}#SBATCH --qos={{ options.qos | sh }}
{% endif %}
# Generated by the lab platform. Do not edit: this script records what was
# submitted, and it is kept with the run.
#
{% for name, value in labels | dictsort %}#   {{ "%-20s" | format(name) }}{{ value }}
{% endfor %}
set -euo pipefail

{% for name, value in environment %}export {{ name }}={{ value | sh }}
{% endfor %}
mkdir -p {{ request.output_directory | string | sh }}

echo "lab: starting {{ labels.run_id }} on $(hostname) at $(date -u +%Y-%m-%dT%H:%M:%SZ)"

set +e
{% for argument in command %}{{ argument | sh }} {% endfor %}
status=$?
set -e

echo "lab: {{ labels.run_id }} finished with status ${status}"
exit "${status}"
